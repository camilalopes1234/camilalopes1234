generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  ADMIN
  SELLER
}

enum LeadStatus {
  ACTIVE
  WON
  LOST
  INACTIVE
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  SCHEDULED
  EVALUATION_COMPLETED
  PROPOSAL_SENT
  NEGOTIATION
  CLOSED
  LOST
}

enum LeadTemperature {
  COLD
  WARM
  HOT
}

enum LeadSourcePrimary {
  INSTAGRAM
  WHATSAPP
  INDICATION
  PAID_TRAFFIC
  WEBSITE
  EVENT
  OTHER
}

enum LeadUrgency {
  LOW
  MEDIUM
  HIGH
}

enum InvestmentRange {
  UP_TO_3K
  BETWEEN_3K_10K
  BETWEEN_10K_25K
  ABOVE_25K
  UNDEFINED
}

enum InteractionType {
  CALL
  WHATSAPP
  INSTAGRAM_DM
  CONSULTATION
  EVALUATION
  PROPOSAL
  FOLLOW_UP
  MEETING
  NOTE
}

enum OpportunityStatus {
  DRAFT
  SENT
  NEGOTIATING
  ACCEPTED
  DECLINED
}

enum TaskStatus {
  PENDING
  COMPLETED
  OVERDUE
}

enum TaskType {
  CALL
  WHATSAPP
  SEND_PROPOSAL
  CONFIRM_EVALUATION
  FOLLOW_UP
  RETURN
  OTHER
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum EvaluationStatus {
  SCHEDULED
  CONFIRMED
  COMPLETED
  NO_SHOW
  RESCHEDULED
  CANCELED
}

enum ActivityEntity {
  LEAD
  INTERACTION
  OPPORTUNITY
  TASK
  EVALUATION
  CONVERSATION
  MESSAGE
  USER
  WHATSAPP_TEMPLATE
  WHATSAPP_CAMPAIGN
}

enum ConversationChannel {
  WHATSAPP
  INSTAGRAM
  WEBCHAT
}

enum ConversationStatus {
  OPEN
  BOT_ACTIVE
  WAITING_HUMAN
  CLOSED
}

enum SenderType {
  CUSTOMER
  BOT
  USER
  SYSTEM
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum MessageType {
  TEXT
  AUDIO
  IMAGE
  VIDEO
  DOCUMENT
}

enum WhatsAppTemplateCategory {
  MARKETING
  UTILITY
  AUTHENTICATION
  SERVICE
}

enum WhatsAppCampaignStatus {
  DRAFT
  READY
  PROCESSING
  COMPLETED
  PAUSED
  FAILED
}

enum WhatsAppCampaignSendMode {
  TEXT
  TEMPLATE
}

enum WhatsAppCampaignRecipientStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  SKIPPED
}

model User {
  id             String        @id @default(cuid())
  name           String
  email          String        @unique
  passwordHash   String
  role           UserRole      @default(SELLER)
  title          String?
  image          String?
  isActive       Boolean       @default(true)
  emailVerified  DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  accounts       Account[]
  sessions       Session[]
  leads          Lead[]        @relation("LeadOwner")
  interactions   Interaction[]
  tasks          Task[]        @relation("TaskOwner")
  opportunities  Opportunity[] @relation("OpportunityOwner")
  evaluations    Evaluation[]  @relation("EvaluationOwner")
  conversations  Conversation[] @relation("ConversationOwner")
  messages       Message[]
  whatsappTemplates WhatsAppTemplate[] @relation("WhatsAppTemplateAuthor")
  whatsappCampaigns WhatsAppCampaign[] @relation("WhatsAppCampaignAuthor")
  activityLogs   ActivityLog[]
}

model Lead {
  id                  String            @id @default(cuid())
  fullName            String
  phone               String
  whatsapp            String?
  email               String?
  instagram           String?
  company             String?
  city                String?
  state               String?
  sourcePrimary       LeadSourcePrimary @default(INSTAGRAM)
  sourceDetail        String?
  source              String
  mainInterest        String?
  investmentRange     InvestmentRange   @default(UNDEFINED)
  urgency             LeadUrgency       @default(MEDIUM)
  notes               String?
  status              LeadStatus        @default(ACTIVE)
  stage               LeadStage         @default(NEW)
  temperature         LeadTemperature   @default(WARM)
  potentialValue      Decimal?          @db.Decimal(12, 2)
  closedValue         Decimal?          @db.Decimal(12, 2)
  attendedEvaluation  Boolean?          @default(false)
  closedAtEvaluation  Boolean?          @default(false)
  whatsappTemplate    String?
  lossReason          String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  lastInteractionAt   DateTime?
  nextActionAt        DateTime?
  ownerId             String
  owner               User              @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  interactions        Interaction[]
  opportunities       Opportunity[]
  tasks               Task[]
  evaluations         Evaluation[]
  conversations       Conversation[]
  whatsappCampaignRecipients WhatsAppCampaignRecipient[]
  activityLogs        ActivityLog[]

  @@index([ownerId])
  @@index([stage])
  @@index([status])
  @@index([sourcePrimary])
}

model Interaction {
  id            String          @id @default(cuid())
  type          InteractionType
  occurredAt    DateTime        @default(now())
  content       String
  nextActionAt  DateTime?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  leadId        String
  userId        String
  lead          Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user          User            @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([leadId, occurredAt])
}

model Opportunity {
  id             String            @id @default(cuid())
  title          String
  estimatedValue Decimal?          @db.Decimal(12, 2)
  finalValue     Decimal?          @db.Decimal(12, 2)
  status         OpportunityStatus @default(DRAFT)
  sentAt         DateTime?
  returnAt       DateTime?
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  leadId         String
  ownerId        String
  lead           Lead              @relation(fields: [leadId], references: [id], onDelete: Cascade)
  owner          User              @relation("OpportunityOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  activityLogs   ActivityLog[]

  @@index([leadId])
  @@index([ownerId])
  @@index([status])
}

model Task {
  id            String       @id @default(cuid())
  title         String
  description   String?
  dueDate       DateTime
  status        TaskStatus   @default(PENDING)
  type          TaskType     @default(FOLLOW_UP)
  priority      TaskPriority @default(MEDIUM)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  completedAt   DateTime?
  leadId        String?
  ownerId       String
  lead          Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  owner         User         @relation("TaskOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  activityLogs  ActivityLog[]

  @@index([ownerId, dueDate])
  @@index([leadId])
  @@index([status])
}

model Evaluation {
  id          String           @id @default(cuid())
  scheduledAt DateTime
  status      EvaluationStatus @default(SCHEDULED)
  attended    Boolean?
  preNotes    String?
  postNotes   String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  leadId      String
  ownerId     String
  lead        Lead             @relation(fields: [leadId], references: [id], onDelete: Cascade)
  owner       User             @relation("EvaluationOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  activityLogs ActivityLog[]

  @@index([leadId])
  @@index([ownerId, scheduledAt])
  @@index([status])
}

model Conversation {
  id                  String              @id @default(cuid())
  channel             ConversationChannel @default(WHATSAPP)
  status              ConversationStatus  @default(OPEN)
  subject             String?
  contactPhone        String?
  externalContactId   String?
  lastMessageAt       DateTime?
  botEnabled          Boolean             @default(true)
  botHandoffRequested Boolean             @default(false)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  leadId              String
  ownerId             String?
  lead                Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  owner               User?               @relation("ConversationOwner", fields: [ownerId], references: [id], onDelete: SetNull)
  messages            Message[]
  campaignRecipients  WhatsAppCampaignRecipient[]
  activityLogs        ActivityLog[]

  @@index([leadId, updatedAt])
  @@index([ownerId])
  @@index([status])
}

model Message {
  id              String           @id @default(cuid())
  body            String
  type            MessageType      @default(TEXT)
  mediaUrl        String?
  mimeType        String?
  fileName        String?
  caption         String?
  durationSeconds Int?
  senderType      SenderType
  direction       MessageDirection
  status          MessageStatus    @default(PENDING)
  externalMessageId String?
  metadata        Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  conversationId  String
  userId          String?
  conversation    Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
  @@index([externalMessageId])
}

model ActivityLog {
  id            String         @id @default(cuid())
  entityType    ActivityEntity
  entityId      String
  action        String
  message       String
  metadata      Json?
  createdAt     DateTime       @default(now())
  leadId        String?
  userId        String
  taskId        String?
  opportunityId String?
  evaluationId  String?
  conversationId String?
  lead          Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  task          Task?          @relation(fields: [taskId], references: [id], onDelete: SetNull)
  opportunity   Opportunity?   @relation(fields: [opportunityId], references: [id], onDelete: SetNull)
  evaluation    Evaluation?    @relation(fields: [evaluationId], references: [id], onDelete: SetNull)
  conversation  Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([leadId])
}

model WhatsAppTemplate {
  id            String                   @id @default(cuid())
  name          String                   @unique
  displayName   String
  category      WhatsAppTemplateCategory @default(MARKETING)
  languageCode  String                   @default("pt_BR")
  bodyText      String
  variableKeys  Json?
  isApproved    Boolean                  @default(false)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt
  createdById   String?
  createdBy     User?                    @relation("WhatsAppTemplateAuthor", fields: [createdById], references: [id], onDelete: SetNull)
  campaigns     WhatsAppCampaign[]

  @@index([createdById])
}

model WhatsAppCampaign {
  id                  String                   @id @default(cuid())
  title               String
  description         String?
  sendMode            WhatsAppCampaignSendMode @default(TEXT)
  status              WhatsAppCampaignStatus   @default(DRAFT)
  messageBody         String
  audienceSearch      String?
  filterStage         LeadStage?
  filterSourcePrimary LeadSourcePrimary?
  filterTemperature   LeadTemperature?
  filterOwnerId       String?
  filterCity          String?
  requiresOptIn       Boolean                  @default(false)
  recipientsCount     Int                      @default(0)
  sentCount           Int                      @default(0)
  deliveredCount      Int                      @default(0)
  readCount           Int                      @default(0)
  failedCount         Int                      @default(0)
  skippedCount        Int                      @default(0)
  scheduledAt         DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  lastDispatchAt      DateTime?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  createdById         String
  templateId          String?
  createdBy           User                     @relation("WhatsAppCampaignAuthor", fields: [createdById], references: [id], onDelete: Restrict)
  template            WhatsAppTemplate?        @relation(fields: [templateId], references: [id], onDelete: SetNull)
  recipients          WhatsAppCampaignRecipient[]

  @@index([createdById, status])
  @@index([filterOwnerId])
  @@index([templateId])
}

model WhatsAppCampaignRecipient {
  id                String                         @id @default(cuid())
  campaignId        String
  leadId            String
  conversationId    String?
  phone             String
  personalizedBody  String?
  status            WhatsAppCampaignRecipientStatus @default(QUEUED)
  providerMessageId String?
  failureReason     String?
  queuedAt          DateTime                       @default(now())
  lastTriedAt       DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  readAt            DateTime?
  createdAt         DateTime                       @default(now())
  updatedAt         DateTime                       @updatedAt
  campaign          WhatsAppCampaign               @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  lead              Lead                           @relation(fields: [leadId], references: [id], onDelete: Cascade)
  conversation      Conversation?                  @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@unique([campaignId, leadId])
  @@index([campaignId, status])
  @@index([leadId])
  @@index([providerMessageId])
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([sessionToken])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@id([identifier, token])
}
